# MySQL Database Config
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=wanderhub_db

# Flask Config
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=wanderhub_super_secret_key_change_this

# JWT Config
JWT_SECRET_KEY=wanderhub_jwt_secret_change_this
JWT_EXPIRY_HOURS=24

# Server
PORT=5000
FRONTEND_URL=http://localhost:3000
